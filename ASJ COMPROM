<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PT AMANAH SAKURA JAPAN</title>

<meta name="description"
content="PT Amanah Sakura Japan - Pendidikan, pelatihan bahasa Jepang dan rekrutmen tenaga kerja Indonesia untuk Jepang.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Serif+JP:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
rel="stylesheet">

<style>

/* =========================================================
   ROOT
========================================================= */

:root{
    --black:#111111;
    --dark:#181818;

    --cream:#f7f3eb;
    --cream2:#eee7da;

    --white:#ffffff;

    --red:#a51d2d;
    --red-dark:#821624;

    --gold:#b79555;
    --gold-light:#d8bf8a;

    --gray:#666666;

    --border:rgba(17,17,17,.10);

    --shadow:0 18px 50px rgba(0,0,0,.10);
}


/* =========================================================
   RESET
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:"DM Sans",sans-serif;
    color:var(--black);
    background:var(--white);
    line-height:1.7;
    overflow-x:hidden;
}

body.lang-jp{
    font-family:"Noto Serif JP","DM Sans",sans-serif;
}

img{
    max-width:100%;
    display:block;
}

a{
    color:inherit;
    text-decoration:none;
}

button{
    font-family:inherit;
}

.container{
    width:min(1180px,92%);
    margin:auto;
}


/* =========================================================
   SCROLL PROGRESS
========================================================= */

.scroll-progress{
    position:fixed;
    top:0;
    left:0;
    width:0%;
    height:3px;
    background:var(--gold);
    z-index:9999;
}


/* =========================================================
   HEADER
========================================================= */

header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:76px;

    display:flex;
    align-items:center;

    background:rgba(247,243,235,.94);
    backdrop-filter:blur(14px);

    border-bottom:1px solid rgba(17,17,17,.08);

    z-index:1000;
}

.nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:30px;
}

.logo-area{
    display:flex;
    align-items:center;
    gap:14px;
}

.logo-circle{
    width:48px;
    height:48px;

    border-radius:50%;

    border:2px solid var(--gold);

    display:flex;
    align-items:center;
    justify-content:center;

    overflow:hidden;

    background:var(--white);
}

.logo-circle img{
    width:100%;
    height:100%;
    object-fit:contain;
}

.logo-text{
    font-weight:700;
    font-size:14px;
    letter-spacing:.08em;
}

.logo-text span{
    display:block;
    color:var(--gold);
    font-size:10px;
    letter-spacing:.18em;
    margin-top:1px;
}

.nav-menu{
    display:flex;
    align-items:center;
    gap:30px;
}

.nav-menu a{
    font-size:13px;
    font-weight:600;
    position:relative;
    padding:5px 0;
}

.nav-menu a::after{
    content:"";
    position:absolute;
    left:0;
    bottom:0;

    width:0;
    height:1px;

    background:var(--red);

    transition:.3s;
}

.nav-menu a:hover::after{
    width:100%;
}

.language-switch{
    display:flex;
    align-items:center;
    gap:4px;

    border:1px solid rgba(17,17,17,.12);
    border-radius:30px;

    padding:4px;
}

.lang-btn{
    border:0;
    background:transparent;

    padding:6px 10px;

    border-radius:20px;

    cursor:pointer;

    font-size:11px;
    font-weight:700;

    color:var(--gray);

    transition:.3s;
}

.lang-btn.active{
    background:var(--black);
    color:var(--white);
}

.mobile-toggle{
    display:none;

    border:0;
    background:transparent;

    font-size:25px;

    cursor:pointer;
}


/* =========================================================
   HERO
========================================================= */

.hero{
    min-height:100vh;
    padding:150px 0 90px;

    position:relative;

    background:
        radial-gradient(
            circle at 85% 15%,
            rgba(183,149,85,.18),
            transparent 28%
        ),
        radial-gradient(
            circle at 10% 90%,
            rgba(165,29,45,.06),
            transparent 30%
        ),
        var(--cream);

    display:flex;
    align-items:center;
}

.hero::before{
    content:"";

    position:absolute;

    top:100px;
    right:-120px;

    width:380px;
    height:380px;

    border:1px solid rgba(183,149,85,.18);

    border-radius:50%;
}

.hero-grid{
    display:grid;
    grid-template-columns:1.05fr .95fr;
    gap:70px;
    align-items:center;
}

.hero-small{
    display:flex;
    align-items:center;
    gap:12px;

    color:var(--red);

    font-size:12px;
    font-weight:700;

    letter-spacing:.18em;

    text-transform:uppercase;

    margin-bottom:20px;
}

.hero-small::before{
    content:"";
    width:38px;
    height:1px;
    background:var(--gold);
}

.hero h1{
    font-family:"Playfair Display",serif;

    font-size:clamp(48px,7vw,88px);

    line-height:1.02;

    letter-spacing:-.04em;

    margin-bottom:25px;
}

.hero h1 span{
    color:var(--red);
}

.hero-description{
    max-width:620px;

    color:var(--gray);

    font-size:16px;

    margin-bottom:32px;
}

.hero-buttons{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;

    min-height:48px;

    padding:0 22px;

    border:1px solid var(--black);

    font-size:12px;
    font-weight:700;

    letter-spacing:.05em;

    transition:.3s;
}

.btn-dark{
    background:var(--black);
    color:var(--white);
}

.btn-dark:hover{
    background:var(--red);
    border-color:var(--red);
}

.btn-outline:hover{
    background:var(--black);
    color:var(--white);
}


/* HERO CARD */

.hero-card{
    position:relative;

    background:var(--black);

    min-height:480px;

    padding:55px;

    display:flex;
    flex-direction:column;
    justify-content:space-between;

    box-shadow:var(--shadow);

    overflow:hidden;
}

.hero-card::before{
    content:"";

    position:absolute;

    width:220px;
    height:220px;

    right:-70px;
    top:-70px;

    border-radius:50%;

    border:1px solid rgba(216,191,138,.25);
}

.hero-card::after{
    content:"";

    position:absolute;

    width:300px;
    height:300px;

    left:-190px;
    bottom:-190px;

    border-radius:50%;

    border:1px solid rgba(216,191,138,.16);
}

.hero-card-top{
    position:relative;
    z-index:2;

    display:flex;
    justify-content:space-between;
    align-items:flex-start;
}

.hero-card-label{
    color:var(--gold-light);

    font-size:11px;
    letter-spacing:.18em;
    text-transform:uppercase;
}

.hero-japan{
    font-family:"Noto Serif JP",serif;

    color:var(--gold-light);

    font-size:75px;

    line-height:1;
}

.hero-card-title{
    position:relative;
    z-index:2;

    color:var(--white);

    font-family:"Playfair Display",serif;

    font-size:36px;

    line-height:1.2;

    max-width:390px;
}

.hero-card-title span{
    color:var(--gold-light);
}

.hero-card-bottom{
    position:relative;
    z-index:2;

    display:flex;
    justify-content:space-between;
    align-items:flex-end;

    gap:20px;
}

.hero-card-line{
    width:70px;
    height:2px;
    background:var(--gold);
}

.hero-card-small{
    color:#aaa;
    font-size:11px;
}


/* =========================================================
   SECTION
========================================================= */

section{
    padding:110px 0;
}

.section-heading{
    margin-bottom:55px;
}

.section-kicker{
    color:var(--red);

    font-size:11px;
    font-weight:700;

    letter-spacing:.18em;
    text-transform:uppercase;

    margin-bottom:13px;
}

.section-title{
    font-family:"Playfair Display",serif;

    font-size:clamp(36px,5vw,58px);

    line-height:1.1;
}

.section-description{
    max-width:650px;

    color:var(--gray);

    margin-top:18px;
}


/* =========================================================
   PROFILE
========================================================= */

.profile{
    background:var(--white);
}

.profile-grid{
    display:grid;
    grid-template-columns:.8fr 1.2fr;
    gap:80px;
    align-items:start;
}

.profile-mark{
    position:relative;

    min-height:390px;

    background:var(--cream);

    display:flex;
    align-items:center;
    justify-content:center;

    overflow:hidden;
}

.profile-mark::before{
    content:"";

    width:270px;
    height:270px;

    border-radius:50%;

    border:1px solid rgba(183,149,85,.45);

    position:absolute;
}

.profile-mark::after{
    content:"桜";

    position:absolute;

    font-family:"Noto Serif JP",serif;

    font-size:120px;

    color:rgba(183,149,85,.20);
}

.profile-mark-text{
    position:relative;
    z-index:2;

    font-family:"Playfair Display",serif;

    font-size:30px;

    text-align:center;
}

.profile-content h3{
    font-family:"Playfair Display",serif;

    font-size:30px;

    margin-bottom:20px;
}

.profile-content p{
    color:var(--gray);

    margin-bottom:18px;
}

.profile-list{
    display:grid;
    grid-template-columns:1fr 1fr;

    gap:12px;

    margin-top:28px;
}

.profile-item{
    padding:17px;

    border:1px solid var(--border);

    background:#fff;
}

.profile-item strong{
    display:block;

    font-size:12px;

    text-transform:uppercase;

    letter-spacing:.08em;

    margin-bottom:4px;
}

.profile-item span{
    font-size:13px;

    color:var(--gray);
}


/* =========================================================
   TEAM
========================================================= */

.team{
    background:var(--cream);
}

.team-grid{
    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:25px;
}

.team-card{
    background:var(--white);

    border:1px solid rgba(17,17,17,.08);

    padding:30px;

    transition:.35s;

    box-shadow:0 8px 30px rgba(0,0,0,.04);
}

.team-card:hover{
    transform:translateY(-8px);

    box-shadow:var(--shadow);
}

.team-photo{
    width:160px;
    height:160px;

    margin:0 auto 25px;

    border-radius:50%;

    border:3px solid var(--gold);

    padding:6px;

    overflow:hidden;

    background:var(--cream);
}

.team-photo img{
    width:100%;
    height:100%;

    object-fit:cover;

    border-radius:50%;
}

.team-info{
    text-align:center;
}

.team-number{
    color:var(--gold);

    font-size:11px;

    font-weight:700;

    letter-spacing:.15em;

    margin-bottom:7px;
}

.team-name{
    font-family:"Playfair Display",serif;

    font-size:25px;

    line-height:1.25;

    margin-bottom:10px;
}

.team-role{
    color:var(--gray);

    font-size:12px;

    line-height:1.7;
}

.role-en{
    font-size:11px;
    color:#777;
}


/* =========================================================
   VISION
========================================================= */

.vision{
    background:var(--black);

    color:var(--white);

    position:relative;

    overflow:hidden;
}

.vision::before{
    content:"";

    position:absolute;

    right:-150px;
    top:-150px;

    width:500px;
    height:500px;

    border-radius:50%;

    border:1px solid rgba(216,191,138,.17);
}

.vision-grid{
    display:grid;

    grid-template-columns:1fr 1fr;

    gap:70px;

    align-items:center;
}

.vision .section-kicker{
    color:var(--gold-light);
}

.vision .section-title{
    color:var(--white);
}

.vision-text{
    color:#b9b9b9;

    margin-top:20px;

    max-width:600px;
}

.vision-box{
    position:relative;

    min-height:330px;

    border:1px solid rgba(216,191,138,.25);

    display:flex;

    align-items:center;

    justify-content:center;

    overflow:hidden;
}

.vision-box::before{
    content:"";

    width:230px;
    height:230px;

    border:1px solid rgba(216,191,138,.25);

    border-radius:50%;

    position:absolute;
}

.vision-kanji{
    position:relative;
    z-index:2;

    font-family:"Noto Serif JP",serif;

    font-size:120px;

    color:var(--gold-light);
}


/* =========================================================
   VALUES
========================================================= */

.values{
    background:var(--cream);
}

.values-grid{
    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:18px;
}

.value-card{
    padding:32px 25px;

    background:var(--white);

    border-top:2px solid var(--gold);

    min-height:210px;

    transition:.3s;
}

.value-card:hover{
    transform:translateY(-5px);

    box-shadow:var(--shadow);
}

.value-number{
    color:var(--gold);

    font-size:12px;

    font-weight:700;

    letter-spacing:.1em;

    margin-bottom:30px;
}

.value-card h3{
    font-family:"Playfair Display",serif;

    font-size:22px;

    margin-bottom:10px;
}

.value-card p{
    color:var(--gray);

    font-size:13px;
}


/* =========================================================
   SERVICES
========================================================= */

.services{
    background:var(--white);
}

.services-grid{
    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:25px;
}

.service-card{
    border:1px solid var(--border);

    padding:40px 32px;

    transition:.35s;

    position:relative;

    overflow:hidden;
}

.service-card::after{
    content:"";

    position:absolute;

    width:100px;
    height:100px;

    border-radius:50%;

    border:1px solid rgba(183,149,85,.18);

    right:-45px;
    bottom:-45px;
}

.service-card:hover{
    border-color:var(--gold);

    transform:translateY(-6px);

    box-shadow:var(--shadow);
}

.service-number{
    font-family:"Playfair Display",serif;

    font-size:38px;

    color:var(--gold);

    margin-bottom:25px;
}

.service-card h3{
    font-family:"Playfair Display",serif;

    font-size:25px;

    margin-bottom:14px;
}

.service-card p{
    color:var(--gray);

    font-size:13px;
}


/* =========================================================
   PROCESS
========================================================= */

.process{
    background:var(--cream2);
}

.process-grid{
    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:0;
}

.process-step{
    padding:35px 28px;

    border-top:1px solid rgba(17,17,17,.18);

    position:relative;
}

.process-step:not(:last-child)::after{
    content:"";

    position:absolute;

    right:0;
    top:34px;

    width:1px;
    height:100px;

    background:rgba(17,17,17,.12);
}

.process-number{
    font-family:"Playfair Display",serif;

    font-size:42px;

    color:var(--gold);

    margin-bottom:18px;
}

.process-step h3{
    font-family:"Playfair Display",serif;

    font-size:21px;

    margin-bottom:10px;
}

.process-step p{
    color:var(--gray);

    font-size:12px;
}


/* =========================================================
   PRINCIPLE
========================================================= */

.principle{
    background:var(--black);

    color:var(--white);
}

.principle-box{
    border:1px solid rgba(216,191,138,.25);

    padding:75px 60px;

    text-align:center;

    position:relative;

    overflow:hidden;
}

.principle-box::before{
    content:"";

    position:absolute;

    left:50%;
    top:50%;

    transform:translate(-50%,-50%);

    width:400px;
    height:400px;

    border-radius:50%;

    border:1px solid rgba(216,191,138,.08);
}

.principle-kanji{
    position:relative;
    z-index:2;

    font-family:"Noto Serif JP",serif;

    color:var(--gold-light);

    font-size:85px;

    margin-bottom:20px;
}

.principle-box h2{
    position:relative;
    z-index:2;

    font-family:"Playfair Display",serif;

    font-size:36px;

    margin-bottom:15px;
}

.principle-box p{
    position:relative;
    z-index:2;

    color:#aaa;

    max-width:700px;

    margin:auto;
}


/* =========================================================
   CONTACT
========================================================= */

.contact{
    background:var(--cream);
}

.contact-grid{
    display:grid;

    grid-template-columns:1fr 1fr;

    gap:60px;

    align-items:start;
}

.contact-info{
    display:flex;

    flex-direction:column;

    gap:15px;

    margin-top:30px;
}

.contact-item{
    display:flex;

    gap:18px;

    padding:20px;

    background:var(--white);

    border:1px solid var(--border);
}

.contact-icon{
    width:42px;
    height:42px;

    flex:none;

    border-radius:50%;

    background:var(--black);

    color:var(--gold-light);

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:14px;
}

.contact-item strong{
    display:block;

    font-size:12px;

    margin-bottom:3px;
}

.contact-item span{
    color:var(--gray);

    font-size:13px;

    word-break:break-word;
}

.contact-card{
    background:var(--black);

    color:var(--white);

    padding:45px;

    position:relative;

    overflow:hidden;
}

.contact-card::before{
    content:"桜";

    position:absolute;

    right:15px;
    bottom:-25px;

    font-family:"Noto Serif JP",serif;

    font-size:150px;

    color:rgba(216,191,138,.08);
}

.contact-card h3{
    position:relative;
    z-index:2;

    font-family:"Playfair Display",serif;

    font-size:32px;

    margin-bottom:15px;
}

.contact-card p{
    position:relative;
    z-index:2;

    color:#aaa;

    font-size:13px;

    margin-bottom:28px;
}

.contact-card .btn{
    position:relative;
    z-index:2;

    background:var(--gold);

    border-color:var(--gold);

    color:var(--black);
}

.contact-card .btn:hover{
    background:var(--gold-light);

    border-color:var(--gold-light);
}


/* =========================================================
   FOOTER
========================================================= */

footer{
    background:var(--black);

    color:var(--white);

    padding:55px 0 25px;
}

.footer-top{
    display:flex;

    justify-content:space-between;

    gap:40px;

    padding-bottom:40px;

    border-bottom:1px solid rgba(255,255,255,.10);
}

.footer-brand{
    max-width:400px;
}

.footer-brand h3{
    font-family:"Playfair Display",serif;

    font-size:25px;

    margin-bottom:12px;
}

.footer-brand p{
    color:#999;

    font-size:12px;
}

.footer-links{
    display:flex;

    gap:55px;
}

.footer-links div{
    display:flex;

    flex-direction:column;

    gap:7px;
}

.footer-links strong{
    color:var(--gold-light);

    font-size:11px;

    letter-spacing:.12em;

    margin-bottom:8px;
}

.footer-links a{
    color:#aaa;

    font-size:12px;

    transition:.2s;
}

.footer-links a:hover{
    color:var(--white);
}

.footer-bottom{
    padding-top:20px;

    display:flex;

    justify-content:space-between;

    gap:20px;

    color:#777;

    font-size:10px;
}


/* =========================================================
   BACK TO TOP
========================================================= */

.back-top{
    position:fixed;

    right:25px;
    bottom:25px;

    width:45px;
    height:45px;

    border:1px solid var(--gold);

    background:var(--black);

    color:var(--gold-light);

    display:flex;

    align-items:center;
    justify-content:center;

    cursor:pointer;

    opacity:0;

    visibility:hidden;

    transform:translateY(10px);

    transition:.3s;

    z-index:999;
}

.back-top.show{
    opacity:1;

    visibility:visible;

    transform:translateY(0);
}

.back-top:hover{
    background:var(--gold);

    color:var(--black);
}


/* =========================================================
   REVEAL
========================================================= */

.reveal{
    opacity:0;

    transform:translateY(30px);

    transition:
        opacity .7s ease,
        transform .7s ease;
}

.reveal.visible{
    opacity:1;

    transform:translateY(0);
}


/* =========================================================
   JAPANESE
========================================================= */

body.lang-jp .hero h1,
body.lang-jp .section-title,
body.lang-jp .team-name,
body.lang-jp .service-card h3,
body.lang-jp .value-card h3,
body.lang-jp .process-step h3,
body.lang-jp .contact-card h3{
    font-family:"Noto Serif JP",serif;
}


/* =========================================================
   RESPONSIVE 1050
========================================================= */

@media(max-width:1050px){

    .nav-menu{
        gap:18px;
    }

    .hero-grid{
        gap:40px;
    }

    .hero-card{
        min-height:430px;

        padding:40px;
    }

    .profile-grid,
    .vision-grid,
    .contact-grid{
        gap:45px;
    }

    .values-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .team-grid{
        grid-template-columns:repeat(3,1fr);
    }

}


/* =========================================================
   RESPONSIVE 700
========================================================= */

@media(max-width:700px){

    header{
        height:68px;
    }

    .nav-menu{
        position:absolute;

        top:68px;
        left:0;

        width:100%;

        background:rgba(247,243,235,.98);

        border-bottom:1px solid var(--border);

        padding:20px;

        display:none;

        flex-direction:column;

        align-items:flex-start;

        gap:14px;
    }

    .nav-menu.open{
        display:flex;
    }

    .mobile-toggle{
        display:block;
    }

    .language-switch{
        margin-left:auto;
    }

    .hero{
        padding-top:125px;

        padding-bottom:70px;
    }

    .hero-grid{
        grid-template-columns:1fr;

        gap:40px;
    }

    .hero-card{
        min-height:390px;
    }

    section{
        padding:80px 0;
    }

    .profile-grid,
    .vision-grid,
    .contact-grid{
        grid-template-columns:1fr;
    }

    .team-grid{
        grid-template-columns:1fr;

        max-width:450px;

        margin:auto;
    }

    .services-grid{
        grid-template-columns:1fr;

        max-width:500px;

        margin:auto;
    }

    .values-grid{
        grid-template-columns:1fr 1fr;
    }

    .process-grid{
        grid-template-columns:1fr 1fr;
    }

    .process-step:nth-child(2)::after{
        display:none;
    }

    .footer-top{
        flex-direction:column;
    }

    .footer-links{
        flex-wrap:wrap;

        gap:30px;
    }

}


/* =========================================================
   RESPONSIVE 430
========================================================= */

@media(max-width:430px){

    .container{
        width:90%;
    }

    .logo-text{
        font-size:12px;
    }

    .logo-text span{
        font-size:8px;
    }

    .logo-circle{
        width:42px;
        height:42px;
    }

    .language-switch{
        padding:2px;
    }

    .lang-btn{
        padding:5px 7px;

        font-size:9px;
    }

    .hero h1{
        font-size:45px;
    }

    .hero-card{
        padding:30px;

        min-height:350px;
    }

    .hero-japan{
        font-size:55px;
    }

    .hero-card-title{
        font-size:28px;
    }

    .profile-list{
        grid-template-columns:1fr;
    }

    .values-grid{
        grid-template-columns:1fr;
    }

    .process-grid{
        grid-template-columns:1fr;
    }

    .process-step:not(:last-child)::after{
        display:none;
    }

    .principle-box{
        padding:55px 25px;
    }

    .principle-kanji{
        font-size:70px;
    }

    .principle-box h2{
        font-size:28px;
    }

    .contact-card{
        padding:30px;
    }

    .footer-links{
        display:grid;

        grid-template-columns:1fr 1fr;
    }

    .footer-bottom{
        flex-direction:column;
    }

}


